<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ========================================
         PERMISOS DE CÁMARA
         ======================================== -->
    
    <!-- Permiso para usar la cámara -->
    <uses-permission android:name="android.permission.CAMERA" />
    
    <!-- Declarar que la app requiere cámara -->
    <uses-feature 
        android:name="android.hardware.camera" 
        android:required="true" />
    
    <!-- Declarar que la app requiere cámara frontal -->
    <uses-feature 
        android:name="android.hardware.camera.front" 
        android:required="true" />
    
    <!-- ========================================
         PERMISOS OPCIONALES
         ======================================== -->
    
    <!-- Para guardar capturas de pantalla (opcional) -->
    <uses-permission 
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />
    
    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_foreground"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.EyeGestures"
        tools:targetApi="31">
        
        <!-- ========================================
             ML KIT FACE DETECTION
             Descarga automática del modelo
             ======================================== -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="face" />
        
        <!-- Opcional: Para forzar descarga al instalar -->
        <!-- Si no se incluye, se descarga en el primer uso -->
        <!--
        <meta-data
            android:name="com.google.mlkit.vision.face.FaceDetectorOptions"
            android:value="face_default" />
        -->
        
        <!-- ========================================
             ACTIVITY PRINCIPAL
             ======================================== -->
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.EyeGestures">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
